<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Usuarios inactivos | Apex</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/panel.css">
</head>

<body>
    <div class="container-fluid">
        <div class="row">
            <%- include('../components/menu'); %>
            <div class="col-10">
                <div class="row-1">
                    <div class="row mt-4">
                        <div class="col-md-12">
                            <h5>Configuración de inactividad de usuarios</h5>
                            <form id="formDesactivarUsuario" class="border p-3 bg-light d-flex flex-column gap-4">
                                <div class="d-flex align-items-center">
                                    <p class="my-0 mx-2">Tiempo de inactividad permitida</p>
                                    <input type="number" id="tiempoInactividad" placeholder="" required>
                                    <select id="unidadInactividad" class="mx-2" required>
                                        <option value="Años">Años</option>
                                        <option value="Meses">Meses</option>
                                        <option value="Días">Días</option>
                                        <option value="Horas">Horas</option>
                                    </select>
                                </div>
                                <div class="d-flex align-items-center">
                                    <p class="my-0 mx-2">Notificar al usuario sobre su inactividad cada</p>
                                    <input type="number" id="tiempoNotificacion" placeholder="" required>
                                    <select id="unidadNotificacion" class="mx-2" required>
                                        <option value="Años">Años</option>
                                        <option value="Meses">Meses</option>
                                        <option value="Días">Días</option>
                                        <option value="Horas">Horas</option>
                                    </select>
                                </div>
                                <div class="d-flex align-items-center">
                                    <p class="my-0 mx-2">Eliminar usuario después de </p>
                                    <input type="number" id="tiempoEliminacion" placeholder="" required>
                                    <select id="unidadEliminacion" class="mx-2" required>
                                        <option value="Años">Años</option>
                                        <option value="Meses">Meses</option>
                                        <option value="Días">Días</option>
                                        <option value="Horas">Horas</option>
                                    </select>
                                    <p class="my-0 mx-2">de inactividad</p>
                                </div>
                                <div class="d-flex align-items-center">
                                    <p class="my-0 mx-2">Guardar información de usuario durante </p>
                                    <input type="number" id="tiempoGuardar" placeholder="" required>
                                    <select id="unidadGuardar" class="mx-2" required>
                                        <option value="Años">Años</option>
                                        <option value="Meses">Meses</option>
                                        <option value="Días">Días</option>
                                        <option value="Horas">Horas</option>
                                    </select>
                                    <p class="my-0 mx-2"> posterior a la eliminación</p>
                                </div>
                                <div class="d-flex align-items-center">
                                    <p class="my-0 mx-2">Tiempo permitido de reactivación de cuenta </p>
                                    <input type="number" id="tiempoReactivacion" placeholder="" required>
                                    <select id="unidadReactivacion" class="mx-2" required>
                                        <option value="Años">Años</option>
                                        <option value="Meses">Meses</option>
                                        <option value="Días">Días</option>
                                        <option value="Horas">Horas</option>
                                    </select>
                                    <p class="my-0 mx-2"> posterior a la eliminación</p>
                                </div>
                                <button type="submit" class="btn btn-primary mt-3">Guardar Configuración</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/services/inactivos.js"></script> 
</body>
</html>
