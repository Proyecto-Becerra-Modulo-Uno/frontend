<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Apex</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/informeActividad.css">
</head>

<body>
    <div class="container-fluid">
        <div class="row">
            <%- include('./components/menu'); %>
            <div class="content col-md-10">

                <h1 class="titulo">Generar Informes de actividad de usuario</h1>
                <div class="linea"></div>

                <div class="contenerdor_buscador">
                    <div class="group">
                        <svg class="icon" aria-hidden="true" viewBox="0 0 24 24">
                            <g>
                                <path
                                    d="M21.53 20.47l-3.66-3.66C19.195 15.24 20 13.214 20 11c0-4.97-4.03-9-9-9s-9 4.03-9 9 4.03 9 9 9c2.215 0 4.24-.804 5.808-2.13l3.66 3.66c.147.146.34.22.53.22s.385-.073.53-.22c.295-.293.295-.767.002-1.06zM3.5 11c0-4.135 3.365-7.5 7.5-7.5s7.5 3.365 7.5 7.5-3.365 7.5-7.5 7.5-7.5-3.365-7.5-7.5z">
                                </path>
                            </g>
                        </svg>
                        <input type="search" class="input">
                    </div>
                </div>

                <div class="container_tabla"> <!-- Contenedor tabla -->
                    <table class="table table-hover"> <!-- TABLA -->
                        <thead>
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">Nombre</th>
                                <th scope="col">Correo</th>
                                <th scope="col">Actividad</th>
                                <th scope="col">Accciones</th>
                            </tr>
                        </thead>
                        <tbody id="data">
                            <tr class="table-active">
                                <th scope="row">1</th>
                                <td>Mark</td>
                                <td> xxxx </td>
                                <td>@mdo</td>
                                <td scope="btnn">
                                    <button class="boton">Generar Informe</button>
                                </td>
                            </tr>
                            <tr>
                                <th scope="row">2</th>
                                <td>Mark</td>
                                <td> xxxx </td>
                                <td>@mdo</td>
                                <td scope="btnn">
                                    <button class="boton">Generar Informe</button>
                                </td>
                            </tr>
                            <tr class="table-active">
                                <th scope="row">3</th>
                                <td>Mark</td>
                                <td> xxxx </td>
                                <td>@mdo</td>
                                <td scope="btnn">
                                    <button class="boton">Generar Informe</button>
                                </td>
                            </tr>
                        </tbody>
                    </table> <!-- CIERRE DE LA TABLA -->
                </div> <!-- CIERRE CONTENEDOR TABLA -->

                <div class="contenedor_boton">
                    <button class="btn-verde">Descarga el informe de Auditoria</button>
                </div>


            </div>
        </div>
        <script>
            document.querySelectorAll('.btn-primary').forEach(button => {
                button.addEventListener('click', () => {
                    const dropdownId = button.id.replace('button', 'dropdown');
                    const dropdown = document.getElementById(dropdownId);
                    dropdown.style.display = dropdown.style.display === 'none' ? 'flex' : 'none';
                });
            });

        </script>
        <script src="/js/informeActividad.js"></script>
        <script src="/js/botones.js"></script>
        <script src="https://stackpath.bootstrapcdn.com/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
</body>

</html>